{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abfahrt",
  // Cloudflare-Konto "EndLab" (laut Cloudflare nicht geheim)
  "account_id": "ef9cbceacd8be6cff839033e54c0cb6b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Eigene Unterdomain. Die alte Route endlab.de/abfahrt* bleibt: Seiten ziehen von dort um.
  "routes": [
    { "pattern": "abfahrt.endlab.de", "custom_domain": true },
    { "pattern": "endlab.de/abfahrt*", "zone_name": "endlab.de" },
  ],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    // React-App (SPA): unbekannte Pfade liefern index.html
    "not_found_handling": "single-page-application",
    // API, App-Seiten und die frühere Adresse /abfahrt/… laufen durch den Worker
    // (#76: Static Assets leiten Pfade mit „%3A“ endlos um). Dateien kommen direkt aus den Assets.
    "run_worker_first": ["/*", "!/assets/*", "!/icons/*", "!/sw.js", "!/manifest.webmanifest"],
  },
  // Push-Auslöser alle 5 Minuten (#72, worker/push/cron.ts)
  "triggers": { "crons": ["*/5 * * * *"] },
  // Spracheingabe (#132): Whisper über Workers AI. Das freie Kontingent (10.000 Neurons/Tag) gilt
  // fürs ganze Konto; SPEECH_DAILY_MINUTES begrenzt den Anteil von Abfahrt (Audio-Minuten je Tag).
  "ai": { "binding": "AI" },
  // Verwaltung hinter Cloudflare Access (Anmeldung über EndLab Login); der Worker prüft den Ausweis
  // selbst und fragt EndLab Login nach der Rolle (worker/admin.ts)
  "vars": {
    "SPEECH_DAILY_MINUTES": "120",
    "ACCESS_TEAM": "endlab-de.cloudflareaccess.com",
    // Öffentliche Kennung der Access-Anwendung (steht in jedem Ausweis), kein Geheimnis
    "ACCESS_AUD": "4e9db034867b61ae0bb1b9ba14b49ed6c4a014ff1e2cc926d4da2f68836bc800", // gitleaks:allow
  },
  "services": [{ "binding": "LOGIN", "service": "endlab-login", "entrypoint": "Intern" }],
  // Push-Abos (#71), Schema in migrations/
  "d1_databases": [
    {
      "binding": "PUSH_DB",
      "database_name": "abfahrt-push",
      "database_id": "0574d7d0-056d-4eaf-9eff-23bde561c8f1",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Staging: Vorschau je Zweig (wrangler preview) mit eigener Push-Datenbank, nie den echten
  // Abos. Migrationen dafür: wrangler.preview-migrations.jsonc (npm run cf:preview).
  "previews": {
    "ai": { "binding": "AI" },
    // Vorschauen haben keine Access-Anwendung: leere AUD sperrt die Verwaltung dort ganz
    "vars": {
      "SPEECH_DAILY_MINUTES": "20",
      "ACCESS_TEAM": "endlab-de.cloudflareaccess.com",
      "ACCESS_AUD": "",
    },
    "services": [{ "binding": "LOGIN", "service": "endlab-login", "entrypoint": "Intern" }],
    "d1_databases": [
      {
        "binding": "PUSH_DB",
        "database_name": "abfahrt-push-vorschau",
        "database_id": "188162d2-8a25-4004-acf3-759389496139",
      },
    ],
    "observability": { "enabled": true },
  },
}
