{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abfahrt",
  // Cloudflare-Konto "EndLab" (laut Cloudflare nicht geheim)
  "account_id": "ef9cbceacd8be6cff839033e54c0cb6b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Produktion unter endlab.de/abfahrt (Zone endlab.de, wie Spieltisch und Tasto).
  // workers.dev bleibt aktiv für die Previews pro PR.
  "routes": [{ "pattern": "endlab.de/abfahrt*", "zone_name": "endlab.de" }],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    // React-App (SPA): unbekannte Pfade liefern index.html
    "not_found_handling": "single-page-application",
    // API, die Weiterleitung /abfahrt -> /abfahrt/ und die App-Seiten laufen durch den Worker
    // (#76: Static Assets leiten Pfade mit „%3A“ endlos um). Dateien kommen direkt aus den Assets.
    "run_worker_first": [
      "/abfahrt",
      "/abfahrt/*",
      "!/abfahrt/assets/*",
      "!/abfahrt/icons/*",
      "!/abfahrt/sw.js",
      "!/abfahrt/manifest.webmanifest",
    ],
  },
  // Push-Abos (#71); angelegt vom Workflow push-setup, Schema in migrations/
  "d1_databases": [
    {
      "binding": "PUSH_DB",
      "database_name": "abfahrt-push",
      "database_id": "0574d7d0-056d-4eaf-9eff-23bde561c8f1",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
