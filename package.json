{
  "name": "abfahrt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc -b",
    "lint": "npm run cf-typegen && oxlint --type-aware --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test:app && npm run test:worker",
    "test:app": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "check": "npm run lint && npm test && npm run build && wrangler deploy --dry-run",
    "db:migrate:preview": "wrangler d1 migrations apply abfahrt-push-vorschau --remote --config wrangler.preview-migrations.jsonc",
    "cf:build": "npm run check",
    "cf:deploy": "wrangler d1 migrations apply abfahrt-push --remote && wrangler deploy",
    "cf:preview": "npm run db:migrate:preview && wrangler preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "jose": "6.2.18",
    "lucide-react": "1.73.0",
    "maplibre-gl": "6.18.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "31.0.1",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "picomatch": "file:vendor/picomatch",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "picomatch": "$picomatch"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false
  }
}
